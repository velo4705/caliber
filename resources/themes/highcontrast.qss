/* ── Caliber High Contrast Theme ─────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    outline: none;
}

QMainWindow, QWidget {
    background-color: #000000;
    color: #ffffff;
}

/* ── Sidebar ──────────────────────────────────────────────────────────────── */
#modeSidebar {
    background: #000000;
    border-right: 2px solid #ffffff;
    min-width: 148px;
    max-width: 148px;
}

#modeSidebar QLabel {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    padding: 4px 0 12px 0;
}

#modeSidebar QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 10px 12px;
    text-align: left;
    color: #cccccc;
    font-size: 13px;
}

#modeSidebar QPushButton:hover {
    background: #222222;
    color: #ffffff;
}

#modeSidebar QPushButton:checked {
    background: #ffffff;
    color: #000000;
    font-weight: bold;
    border-left: 3px solid #ffff00;
}

/* ── Display widget ───────────────────────────────────────────────────────── */
#displayWidget {
    background: #111111;
    border: 2px solid #ffffff;
    border-radius: 8px;
    padding: 4px;
}

#expressionLabel {
    color: #aaaaaa;
    font-size: 13px;
    padding: 2px 8px 0 8px;
}

#resultLabel {
    color: #ffffff;
    font-size: 30px;
    font-weight: bold;
    padding: 0 8px 4px 8px;
}

/* ── Calc buttons ─────────────────────────────────────────────────────────── */
QPushButton[class="calcButton"] {
    background: #111111;
    border: 2px solid #ffffff;
    border-radius: 6px;
    font-size: 16px;
    color: #ffffff;
    min-height: 52px;
}
QPushButton[class="calcButton"]:hover {
    background: #333333;
}
QPushButton[class="calcButton"]:pressed { background: #555555; }

QPushButton[class="operatorButton"] {
    background: #111111;
    border: 2px solid #ffff00;
    border-radius: 6px;
    font-size: 16px;
    color: #ffff00;
    min-height: 52px;
    font-weight: 600;
}
QPushButton[class="operatorButton"]:hover {
    background: #333300;
    color: #ffffff;
}
QPushButton[class="operatorButton"]:pressed { background: #555500; }

QPushButton[class="actionButton"] {
    background: #ffffff;
    border: 2px solid #ffffff;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    color: #000000;
    min-height: 52px;
}
QPushButton[class="actionButton"]:hover { background: #dddddd; }
QPushButton[class="actionButton"]:pressed { background: #bbbbbb; }

QPushButton[class="clearButton"] {
    background: #111111;
    border: 2px solid #ff4444;
    border-radius: 6px;
    font-size: 16px;
    color: #ff4444;
    min-height: 52px;
}
QPushButton[class="clearButton"]:hover {
    background: #330000;
    color: #ff8888;
}
QPushButton[class="clearButton"]:pressed { background: #550000; }

/* ── History panel ────────────────────────────────────────────────────────── */
#historyPanel {
    background: #000000;
    border-left: 2px solid #ffffff;
}

#historyPanel QLabel {
    background: transparent;
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
}

#historyPanel QListWidget {
    background: transparent;
    border: none;
    font-size: 12px;
}

#historyPanel QListWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #333333;
    color: #ffffff;
    border-radius: 4px;
}

#historyPanel QListWidget::item:hover { background: #222222; }
#historyPanel QListWidget::item:selected {
    background: #ffffff;
    color: #000000;
}

#historyPanel QPushButton {
    background: #330000;
    color: #ff4444;
    border: 1px solid #ff4444;
    border-radius: 6px;
    padding: 6px;
    font-size: 12px;
}
#historyPanel QPushButton:hover { background: #550000; }

/* ── Toolbar ──────────────────────────────────────────────────────────────── */
QToolBar {
    background: #000000;
    border-bottom: 2px solid #ffffff;
    spacing: 4px;
    padding: 2px 6px;
}

#historyToggleBtn {
    background: #111111;
    color: #ffffff;
    border: 2px solid #ffffff;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 13px;
}
#historyToggleBtn:hover { background: #333333; }
#historyToggleBtn:checked { background: #ffffff; color: #000000; }

/* ── Tabs ─────────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 2px solid #ffffff;
    border-radius: 6px;
    background: #111111;
}

QTabBar::tab {
    background: #000000;
    color: #aaaaaa;
    border: 2px solid #555555;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 6px 14px;
    margin-right: 2px;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #000000;
    font-weight: bold;
    border-color: #ffffff;
}

QTabBar::tab:hover:!selected { background: #222222; color: #ffffff; }

/* ── Inputs / Combos ──────────────────────────────────────────────────────── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit {
    background: #111111;
    border: 2px solid #ffffff;
    border-radius: 4px;
    padding: 5px 8px;
    color: #ffffff;
    selection-background-color: #ffffff;
    selection-color: #000000;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QDateEdit:focus {
    border: 2px solid #ffff00;
}

QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #111111;
    border: 2px solid #ffffff;
    color: #ffffff;
    selection-background-color: #ffffff;
    selection-color: #000000;
}

/* ── Scrollbar ────────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #000000;
    width: 10px;
    border-radius: 5px;
    border: 1px solid #555555;
}
QScrollBar::handle:vertical {
    background: #ffffff;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #ffff00; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ── Menu bar ─────────────────────────────────────────────────────────────── */
QMenuBar {
    background: #000000;
    color: #ffffff;
    padding: 2px;
    border-bottom: 2px solid #ffffff;
}
QMenuBar::item:selected { background: #ffffff; color: #000000; border-radius: 4px; }
QMenu {
    background: #111111;
    border: 2px solid #ffffff;
    border-radius: 4px;
}
QMenu::item { padding: 6px 24px; color: #ffffff; }
QMenu::item:selected { background: #ffffff; color: #000000; }

/* ── Table widget ─────────────────────────────────────────────────────────── */
QTableWidget {
    background: #111111;
    border: 2px solid #ffffff;
    border-radius: 4px;
    gridline-color: #444444;
    color: #ffffff;
}
QTableWidget::item { padding: 4px; }
QTableWidget::item:selected { background: #ffffff; color: #000000; }
QHeaderView::section {
    background: #000000;
    color: #ffffff;
    border: 1px solid #ffffff;
    padding: 4px;
    font-weight: bold;
    font-size: 12px;
}

/* ── Radio / Checkbox ─────────────────────────────────────────────────────── */
QRadioButton, QCheckBox {
    color: #ffffff;
    spacing: 6px;
}
QRadioButton::indicator, QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 2px solid #ffffff;
    border-radius: 8px;
    background: #000000;
}
QRadioButton::indicator:checked {
    background: #ffff00;
    border-color: #ffff00;
}
QCheckBox::indicator { border-radius: 3px; }
QCheckBox::indicator:checked {
    background: #ffff00;
    border-color: #ffff00;
}

/* ── Labels ───────────────────────────────────────────────────────────────── */
QLabel { color: #ffffff; background: transparent; }

/* ── Graph bottom panel ───────────────────────────────────────────────────── */
#graphBottomPanel {
    background: #000000;
    border-top: 2px solid #ffffff;
}

/* ── Graph right sidebar ──────────────────────────────────────────────────── */
#graphSidebar {
    background: #000000;
    border-left: 2px solid #ffffff;
}
#graphSidebar QLineEdit {
    background: #111111;
    border: 1px solid #ffffff;
    border-radius: 4px;
    color: #ffffff;
}
#graphSidebar QDoubleSpinBox {
    background: #111111;
    border: 1px solid #ffffff;
    border-radius: 4px;
    color: #ffffff;
}
